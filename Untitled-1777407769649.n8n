        "nodeCredentialType": "tiktokApi",
        "options": {}
      },
      "id": "a9664e77-999a-4197-a11b-fa15a708620a",
      "name": "TikTok Comment Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        16,
        576
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "messages": {
          "values": [
            {
              "content": "You are an AI customer service agent that adapts to different social media platforms. \n\nPlatform-specific guidelines:\n- TWITTER: Keep responses under 280 characters, use relevant hashtags, casual tone\n- FACEBOOK: Friendly, conversational, can be longer format, use emojis moderately  \n- LINKEDIN: Professional tone, business-focused, formal language\n- GMAIL: Professional email format, detailed responses, proper email etiquette\n- TIKTOK: Trendy, youth-oriented language, use popular slang appropriately, keep it fun\n\nGeneral rules:\n1. Always be helpful and solution-oriented\n2. If you detect high purchase intent, end with [HOT_LEAD]\n3. Match the tone and style of the platform\n4. Provide accurate information about products/services\n5. Escalate complex issues when needed\n\nCompany Info:\n- Free shipping on orders over $50\n- 30-day return policy\n- Support hours: 9 AM - 6 PM EST\n- Processing: 1-3 business days",
              "role": "system"
            },
            {
              "content": "Platform: {{ $json.body.platform }}\nCustomer: {{ $json.body.customer_name || 'Customer' }}\nMessage: {{ $json.body.message }}\nContext: {{ $json.body.context || 'General inquiry' }}"
            }
          ]
        },
        "options": {
          "maxTokens": 500,
          "temperature": 0.7
        }
      },
      "id": "4481d4b7-0cb5-4d0d-b460-8157ba5d79fe",
      "name": "AI Response Generator",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        -288,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hot-lead-check",
              "leftValue": "={{ $json.choices[0].message.content }}",
              "rightValue": "HOT_LEAD",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combineOperation": "any"
        },
        "options": {}
      },
      "id": "77c7bce2-26dd-448f-98d9-317050956fd4",
      "name": "Hot Lead Detector",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        224,
        320
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEETS_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Multi-Platform-Leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "values": {
            "Timestamp": "={{ new Date().toISOString() }}",
            "Platform": "={{ $('Universal Social Media Webhook').item.json.body.platform }}",
            "Customer_ID": "={{ $('Universal Social Media Webhook').item.json.body.customer_id || 'unknown' }}",
            "Customer_Name": "={{ $('Universal Social Media Webhook').item.json.body.customer_name || 'unknown' }}",
            "Customer_Email": "={{ $('Universal Social Media Webhook').item.json.body.email_address || 'N/A' }}",
            "Message": "={{ $('Universal Social Media Webhook').item.json.body.message }}",
            "AI_Response": "={{ $('AI Response Generator').item.json.choices[0].message.content.replace('[HOT_LEAD]', '') }}",
            "Is_Hot_Lead": "={{ $('AI Response Generator').item.json.choices[0].message.content.includes('[HOT_LEAD]') ? 'YES' : 'NO' }}",
            "Lead_Score": "={{ $('AI Response Generator').item.json.choices[0].message.content.includes('[HOT_LEAD]') ? 95 : Math.floor(Math.random() * 50) + 25 }}",
            "Context": "={{ $('Universal Social Media Webhook').item.json.body.context || 'General' }}"
          }
        },
        "options": {}
      },
      "id": "c16ca39f-445e-4e0b-8fb3-8cce629baca1",
      "name": "Multi-Platform Data Logger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        416,
        320
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "🔥 HOT LEAD ALERT! 🔥\n\n📱 Platform: {{ $('Universal Social Media Webhook').item.json.body.platform.toUpperCase() }}\n👤 Customer: {{ $('Universal Social Media Webhook').item.json.body.customer_name || 'Anonymous' }}\n📧 Email: {{ $('Universal Social Media Webhook').item.json.body.email_address || 'Not provided' }}\n💬 Message: {{ $('Universal Social Media Webhook').item.json.body.message }}\n🤖 AI Response: {{ $('AI Response Generator').item.json.choices[0].message.content.replace('[HOT_LEAD]', '') }}\n\n⏰ Time: {{ new Date().toLocaleString() }}\n🎯 Action: Follow up within 15 minutes!",
        "additionalFields": {}
      },
      "id": "a71e852c-9e75-4a49-92fa-6a375c5e2397",
      "name": "Hot Lead Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        224,
        112
      ],
      "webhookId": "8a08dbe1-9292-4f14-a457-f04222013f23"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \n  \"status\": \"success\",\n  \"platform\": $('Universal Social Media Webhook').item.json.body.platform,\n  \"response_sent\": true,\n  \"ai_response\": $('AI Response Generator').item.json.choices[0].message.content.replace('[HOT_LEAD]', ''),\n  \"is_hot_lead\": $('AI Response Generator').item.json.choices[0].message.content.includes('[HOT_LEAD]'),\n  \"timestamp\": new Date().toISOString()\n} }}",
        "options": {}
